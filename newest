.grad{display:inline-block;width:60px;height:6px;vertical-align:middle;margin-right:6px;background:linear-gradient(90deg,#123b39,var(--blue),var(--rose))}

.atlas{display:grid;grid-template-columns:62px repeat(5,minmax(96px,1fr));gap:10px 14px;min-width:620px}
.axis{display:flex;flex-direction:column;justify-content:center;gap:3px;font:500 10.5px var(--mono);color:var(--sand);letter-spacing:.06em}
.axis.col{justify-content:flex-end}
.axis input{text-align:center;padding:4px;color:var(--sand);border-color:var(--line)}
.corner{font:500 10px var(--mono);color:var(--muted);display:flex;flex-direction:column;justify-content:flex-end;gap:2px;letter-spacing:.06em}
.cellwrap{display:flex;flex-direction:column;gap:4px;min-width:0;transition:opacity .15s}
.cellwrap.dim{opacity:.16}
.clabel{display:flex;justify-content:space-between;align-items:center;gap:4px;font:500 10.5px var(--mono);color:var(--blue);min-height:16px}
