.board-title{font:700 20px var(--ui);letter-spacing:.06em;text-transform:uppercase;margin:0}
.board-sub{font:500 11px var(--mono);letter-spacing:.12em;color:var(--blue);margin:3px 0 16px;text-transform:uppercase}
