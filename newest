<title>Member Matrix</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@400;500;600;700&display=swap">
<style>
:root{
  color-scheme:dark;
  --bg:#000000; --board:#000000; --panel:#000000; --panel2:#0E1016; --rule:#353B49; --line:#1E2431;
  --catG:#A78BFA; --catO:#3FD0C9; --catL:#FF6F61; --ink:#F1F3F8; --muted:#8B93A7; --blue:#3FD0C9; --rose:#FF6F61; --wine:#C0395A; --lav:#F8F6EE; --sand:#A78BFA;
  --ui:"IBM Plex Sans Condensed","Arial Narrow",system-ui,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{background:var(--bg)}
body{color:var(--ink);font-family:var(--ui);font-size:14px;line-height:1.45;padding-inline:16px;padding-block:16px 40px}
.top{max-width:1500px;margin:0 auto 14px;display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:10px 24px}
.eyebrow{font:500 11px var(--mono);letter-spacing:.14em;color:var(--blue);margin:0 0 4px;text-transform:uppercase}
h1{font:700 26px/1.1 var(--ui);letter-spacing:.02em;margin:0;text-transform:uppercase}
.sub{color:var(--muted);font-size:13.5px;margin:6px 0 0;max-width:70ch}
.wrap{max-width:1500px;margin:0 auto;display:grid;grid-template-columns:270px minmax(0,1fr) 290px;gap:16px;align-items:start}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:3px}
.sticky{position:sticky;top:calc(env(safe-area-inset-top,0px) + 10px);max-height:calc(100vh - 20px);overflow:auto}
details{border-bottom:1px solid var(--line)}
details:last-child{border-bottom:0}
summary{cursor:pointer;list-style:none;padding:11px 14px;font:600 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink);display:flex;justify-content:space-between;gap:8px}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";color:var(--muted)}
details[open] summary::after{content:"–"}
summary .step{color:var(--sand)}
.sec{padding:0 14px 14px;display:flex;flex-direction:column;gap:9px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.field{display:flex;flex-direction:column;gap:3px;font-size:12px;color:var(--muted)}
input[type=number],input[type=text],select{font:500 12.5px var(--mono);color:var(--ink);background:var(--board);border:1px solid var(--rule);border-radius:2px;padding:6px 7px;width:100%;min-width:0}
input[type=range]{width:100%;accent-color:var(--sand)}
input[type=checkbox]{accent-color:var(--blue)}
input:focus-visible,select:focus-visible,button:focus-visible,summary:focus-visible,canvas:focus-visible{outline:2px solid var(--blue);outline-offset:1px}
.seg{display:flex;border:1px solid var(--rule);border-radius:2px;overflow:hidden}
.seg button{flex:1;white-space:nowrap;border:0;border-left:1px solid var(--rule);border-radius:0;background:var(--board);color:var(--muted);padding:7px 4px;font:600 12px var(--ui)}
.seg button:first-child{border-left:0}
.seg button[aria-pressed=true]{background:var(--ink);color:var(--board)}
button{font:600 13px var(--ui);cursor:pointer;border-radius:2px;border:1px solid var(--rule);background:var(--panel2);color:var(--ink);padding:7px 10px}
button:hover{border-color:var(--muted)}
button.primary{background:var(--sand);border-color:var(--sand);color:#15120B}
button:disabled{opacity:.4;cursor:not-allowed}
.btns{display:flex;flex-wrap:wrap;gap:6px}
.btns button{flex:1 1 auto}
.check{display:flex;align-items:center;gap:8px;font-size:13px}
.checks{display:grid;grid-template-columns:1fr 1fr;gap:4px 10px}
.hint{font-size:12px;color:var(--muted);margin:0}
.warn{color:var(--rose)}
input.bad{border-color:var(--rose)!important}
.swatches{display:flex;gap:6px;flex-wrap:wrap;margin-top:4px}.colgrid{display:grid;grid-template-columns:1fr 1fr;gap:6px 10px;margin-top:4px}
.colf{display:flex;align-items:center;gap:7px;font:500 12px var(--ui);color:var(--muted)}
input[type=color]{width:34px;height:24px;padding:0;border:1px solid var(--line);border-radius:3px;background:none;cursor:pointer;flex:none}
.stackwrap{display:grid;grid-template-columns:minmax(230px,300px) 1fr;gap:18px;align-items:start}@media(max-width:900px){.stackwrap{grid-template-columns:1fr}}
.stackside{display:flex;flex-direction:column;gap:8px}.stackmain{display:flex;flex-direction:column;gap:10px}
.stpick{display:grid;grid-template-columns:repeat(5,1fr);gap:4px}.stp{padding:0;border:1px solid var(--line);background:#07080B;display:flex;flex-direction:column;cursor:pointer;border-radius:2px}
.stp canvas{width:100%;aspect-ratio:1;display:block}.stp span{font:500 9px var(--mono);color:var(--muted);padding:1px 0 2px}.stp[aria-pressed=true]{border-color:var(--lav);box-shadow:0 0 0 2px var(--lav)}.stp:hover{border-color:var(--blue)}
.stlayers{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px}.stlayers li{display:grid;grid-template-columns:12px minmax(0,1fr) auto auto auto auto;gap:5px;align-items:center;font:500 11.5px var(--ui);background:var(--panel);border:1px solid var(--line);padding:4px 6px;border-radius:3px}
.stlayers .stl{display:flex;flex-direction:column;gap:3px;min-width:0}.stlayers .stl span{overflow-wrap:anywhere}.stlayers select{font:500 10.5px var(--mono);padding:1px 3px;width:100%;min-width:150px}.stlayers li.boolop{margin-left:14px;border-style:dashed}
.stlayers li i{width:12px;height:12px;border-radius:2px;display:block}.stlayers input{width:52px;padding:2px 4px}.stlayers button{padding:2px 7px;min-width:0}.stlayers label{font:500 10px var(--mono);color:var(--muted);display:flex;gap:3px;align-items:center}
.mixrow{display:flex;flex-wrap:wrap;align-items:center;gap:6px;font:500 11px var(--mono);color:var(--muted)}.mixrow i{display:inline-block;width:14px;height:14px;border-radius:2px;vertical-align:middle;margin-right:3px}

/* stage */
.stage{min-width:0;display:flex;flex-direction:column;gap:12px}
.bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px}
.tabs{display:flex;gap:0;border:1px solid var(--rule);border-radius:2px;overflow:hidden}
.tabs button{border:0;border-left:1px solid var(--rule);border-radius:0;background:var(--panel);color:var(--muted);font:600 11px var(--mono);letter-spacing:.1em;text-transform:uppercase;padding:9px 14px}
.tabs button:first-child{border-left:0}
.tabs button[aria-selected=true]{background:var(--ink);color:var(--board)}
