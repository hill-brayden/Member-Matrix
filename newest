function sandMetrics(){const cv=$('sand');const r=cv.getBoundingClientRect();const pad=Math.round(r.width*.04);const pw=r.width-2*pad;return{r,pad,pw,s:pw/S.W};}
function toSection(e){const{r,pad,s}=sandMetrics();return[(e.clientX-r.left-pad)/s-S.W/2,S.H/2-(e.clientY-r.top-pad)/s];}
function bindSandbox(){const cv=$('sand');
  cv.addEventListener('pointerdown',e=>{const p=toSection(e);const{s}=sandMetrics();cv.setPointerCapture(e.pointerId);
    const which=dist(p,S.start)<dist(p,S.end)?'start':'end';if(dist(p,S[which])*s<24)drag={type:'end',which};});
  cv.addEventListener('pointermove',e=>{if(!drag)return;const p=toSection(e);const cl=v=>[Math.max(-S.W/2,Math.min(S.W/2,v[0])),Math.max(-S.H/2,Math.min(S.H/2,v[1]))];
    S[drag.which]=cl(p).map(v=>+v.toFixed(2));clampEnds();renderSandbox();});
