.rexp p{margin:0}.rexp .metrics{margin:0}table.why{width:100%;border-collapse:collapse;font:500 10px var(--mono);table-layout:fixed}table.why th:nth-child(1){width:31%}table.why th:nth-child(4){width:15%}table.why th:nth-child(5){width:16%}table.why td:nth-child(4),table.why td:nth-child(5){white-space:nowrap}table.why td,table.why th{overflow-wrap:anywhere}table.why th{text-align:left;color:var(--muted);font-weight:500;border-bottom:1px solid var(--line);padding:3px 4px}
table.why td{padding:3px 4px;border-bottom:1px solid #1a1e27;vertical-align:top}table.why td .hint{font-size:10.5px}table.why .pos{color:var(--blue)}table.why .neg{color:var(--rose)}
button.rrow{width:100%;background:none;border:0;padding:2px 0;color:inherit;font:inherit;cursor:pointer;text-align:left}button.rrow:hover .rname{color:var(--ink)}
.axis select{width:100%;text-align:center;padding:4px;color:var(--sand);background:var(--panel);border:1px solid var(--line);border-radius:3px;font:500 12px var(--mono)}
.typo-card strong{font:600 15px var(--ui)}
.chip.G{background:var(--catG)}.chip.O{background:var(--catO)}.chip.L{background:var(--catL)}

/* sandbox */
.sandtools{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;margin-bottom:12px}
.sandcanvas{display:block;width:100%;max-width:760px;height:auto;margin:0 auto;touch-action:none;cursor:crosshair}
.scrub{display:flex;align-items:center;gap:10px;margin-top:12px;max-width:760px;margin-inline:auto}
.scrub button{white-space:nowrap}
.scrub span{font:500 11px var(--mono);color:var(--muted);white-space:nowrap;min-width:9ch}
.sbgrid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:22px;align-items:start}
.ratingsbox{display:flex;flex-direction:column;gap:10px}
.ratings{display:flex;flex-direction:column;gap:12px}
.rgroup{display:flex;flex-direction:column;gap:5px}
.rgroup .lbl{color:var(--blue)}
.rrow{display:grid;grid-template-columns:112px 1fr 30px;gap:8px;align-items:center;font-size:13px;cursor:help}
.rbar{height:10px;background:#15171d;position:relative;background-image:repeating-linear-gradient(90deg,transparent 0 calc(10% - 1px),#000 calc(10% - 1px) 10%)}
.rbar i{position:absolute;inset:0 auto 0 0;background:var(--rose);display:block}
.rval{font:600 12px var(--mono);text-align:right;font-variant-numeric:tabular-nums}
@media (max-width:1100px){.sbgrid{grid-template-columns:1fr}}
.process{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.process figure{margin:0;display:flex;flex-direction:column;gap:8px}
.process canvas{width:100%;height:auto;display:block}
.process figcaption{font:500 10.5px var(--mono);letter-spacing:.1em;color:var(--muted);text-transform:uppercase}
.process figcaption b{color:var(--ink);font-weight:600;display:block;letter-spacing:.12em}

/* right */
.insp{padding:14px;display:flex;flex-direction:column;gap:10px;border-bottom:1px solid var(--line)}
.lbl{font:600 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin:0}
.insp-id{font:600 22px var(--mono);color:var(--blue);margin:0;line-height:1}
.insp-recipe{font:500 12px var(--mono);color:var(--muted);margin:4px 0 0}
.metrics{display:grid;grid-template-columns:1fr auto;gap:3px 10px;font:500 11.5px var(--mono);margin:0}
.metrics dt{color:var(--muted)}
.metrics dd{margin:0;text-align:right;font-variant-numeric:tabular-nums}
.cat-sec{padding:14px;display:flex;flex-direction:column;gap:10px}
.cat{display:flex;flex-direction:column;gap:1px}
.cat-h{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;text-align:left;padding:7px 10px;border-left:3px solid var(--c);background:var(--panel2)}
.cat-h.on{background:var(--c);color:#0B0D12}
.typ{display:grid;grid-template-columns:24px 1fr auto;gap:6px;align-items:center;text-align:left;font-weight:500;font-size:13px;padding:5px 10px;border-color:transparent;background:transparent}
.typ:hover{border-color:var(--rule)}
.typ.on{border-color:var(--c);background:var(--panel2)}
.typ .n{font:600 10.5px var(--mono);color:var(--c)}
.count{font:500 10.5px var(--mono);color:var(--muted);background:var(--board);border-radius:8px;padding:0 7px}
.cat-h.on .count{background:rgba(0,0,0,.2);color:#0B0D12}

.gallery{display:flex;flex-direction:column;gap:14px}
.gal-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px}
.gal-head h2{font:700 16px var(--ui);letter-spacing:.04em;text-transform:uppercase;margin:0;text-wrap:balance}
.gal-group h3{font:600 13px var(--ui);margin:0 0 8px;display:flex;gap:8px;align-items:baseline}
.gal-group h3 .n{font:600 11px var(--mono);color:var(--c)}
.gal-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.gal-item{display:flex;flex-direction:column;gap:4px;padding:0;border:0;background:transparent;text-align:left}
.gal-item span{font:500 10.5px var(--mono);color:var(--muted)}
.empty{color:var(--muted);font-size:13px;margin:0}

.toast{position:fixed;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 18px);transform:translateX(-50%);background:var(--ink);color:var(--board);padding:8px 14px;border-radius:2px;font-size:13px;z-index:30}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;padding:16px;z-index:20}
.modal-card{background:var(--panel);border:1px solid var(--rule);padding:14px;max-width:min(1000px,100%);max-height:100%;overflow:auto;display:flex;flex-direction:column;gap:10px}
.modal-card img{max-width:100%}

@media (max-width:1180px){
  .wrap{grid-template-columns:250px minmax(0,1fr)}
  .right{grid-column:1 / -1}
  .right .panel{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
  .insp{border-bottom:0;border-right:1px solid var(--line)}
}
@media (max-width:780px){
  .wrap{grid-template-columns:1fr}
  .sticky{position:static;max-height:none}
  .process{grid-template-columns:1fr}
  .right .panel{display:block}
}
@media (prefers-reduced-motion:reduce){.cellwrap{transition:none}}
/* saved library */
.libbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:6px 0 14px}
.libsec{margin:18px 0 6px;font:600 11px/1.3 var(--mono,monospace);letter-spacing:.12em;text-transform:uppercase;color:var(--muted,#8B93A7)}
.libgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(168px,1fr));gap:12px}
.libcard{border:1px solid var(--rule);background:#07080B;padding:8px;display:flex;flex-direction:column;gap:6px;min-width:0}
.libcard img{width:100%;aspect-ratio:1/1;object-fit:contain;background:#000;display:block}
.libcard input{width:100%;box-sizing:border-box;font-size:12px}
.libcard .meta{font-size:11px;color:var(--muted,#8B93A7);word-break:break-word}
.libcard .btns{display:flex;flex-wrap:wrap;gap:4px}.libcard .btns button{font-size:11px;padding:4px 7px}
.typogen{display:grid;grid-template-columns:1fr auto;gap:6px;align-items:center}
</style>

<header class="top">
  <div>
    <p class="eyebrow">Perceptual Path / web studio</p>
    <h1>Member Matrix</h1>
    <p class="sub">Rows set member count and columns set member length. In every cell the process runs members → movement → visibility → filtering → connectivity → envelope. The members block movement and sightlines. Stations along the agent's route test which free space they can see, and the space that is well seen, clear for the agent and connected to the route becomes the envelope. That envelope is what gets sorted into a typology.</p>
  </div>
  <div class="btns">
    <button id="regen" type="button">Regenerate all</button>
    <button id="saveMatrix" type="button">Save matrix</button>
    <button id="expBoard" type="button" class="primary">Export view PNG</button>
    <button id="expBoardSvg" type="button">Export view SVG</button>
  </div>
</header>

<div class="wrap">
  <aside class="panel sticky" id="controls" aria-label="Study controls"></aside>

  <main class="stage">
    <div class="bar">
      <div class="tabs" role="tablist" aria-label="View">
        <button type="button" role="tab" data-view="GRID">Matrix atlas</button>
        <button type="button" role="tab" data-view="SANDBOX">Sandbox</button>
        <button type="button" role="tab" data-view="PROCESS">Process</button>
        <button type="button" role="tab" data-view="STACK">Stack</button>
        <button type="button" role="tab" data-view="SAVED">Saved</button>
      </div>
      <div class="status" id="status" role="status"></div>
    </div>
    <section class="board" id="board"></section>
    <section class="board gallery" id="comboBox" hidden></section>
    <section class="board gallery" id="gallery" hidden></section>
  </main>

  <aside class="right">
    <div class="panel sticky">
      <div class="insp" id="inspector"></div>
      <div class="cat-sec">
        <p class="lbl">Envelope typologies</p>
        <p class="hint">Each cell is sorted by its envelope alone (proportion, depth, steps, ledges, pockets, pinches, edge contact), compared across all 25 cells. The path and members only matter through the envelope they produce. Click a category or typology to see every envelope sorted into it. You can override any cell above.</p>
        <div id="typList" class="cat-sec" style="padding:0"></div>
        <button id="clearFilter" type="button">Show all cells</button>
      </div>
    </div>
  </aside>
</div>

<script>
/* =========================================================
   Palette (Perceptual Path DG_HEX)
   ========================================================= */
const PAL={route:'#F8F6EE',short:'#A78BFA',cloud:'#3FD0C9',start:'#A78BFA',end:'#F8F6EE',floor:'#A78BFA',lav:'#F8F6EE',ink:'#F1F3F8',blue:'#3FD0C9',rose:'#FF6F61',wine:'#C0395A',sand:'#A78BFA',muted:'#8B93A7',rule:'#2B3140',dark:'#000000',section:'#000000',member:'#8E97A8'};
/* every cell's envelope has its own colour: the hue steps down the rows and along the columns */
function hslRgb(hh,s,l){const f=n=>{const k=(n+hh/30)%12,a=s*Math.min(l,1-l);return Math.round(255*(l-a*Math.max(-1,Math.min(k-3,9-k,1))));};return[f(0),f(8),f(4)];}
const rgbHex=c=>'#'+c.map(v=>Math.max(0,Math.min(255,Math.round(v))).toString(16).padStart(2,'0')).join('');
const specRGB=i=>{const r=Math.floor(i/5),c=i%5;return hslRgb((350+c*16+r*62)%360,.8,.64);};
const DEF_COLORS={route:'#F8F6EE',short:'#A78BFA',member:'#8E97A8',cloud:'#3FD0C9',start:'#A78BFA',end:'#F8F6EE',floor:'#A78BFA',buttons:'#A78BFA',accent:'#3FD0C9',catG:'#A78BFA',catO:'#3FD0C9',catL:'#FF6F61'};
const DEF_ROWS=[0,1,2,3,4].map(r=>rgbHex(specRGB(r*5+2))),DEF_COLS=[0,1,2,3,4].map(c=>rgbHex(hslRgb((350+c*72)%360,.8,.64)));
// every cell's envelope colour: the built-in spectrum, its row's colour, its column's colour, a blend of both, or one picked by hand
function cellRGB(i){const o=S.cellCol&&S.cellCol[i];if(o)return hexRgb(o);const r=Math.floor(i/5),c=i%5,m=S.envColorMode||'SPECTRUM';
  if(m==='ROW')return hexRgb(S.rowCols[r]);if(m==='COL')return hexRgb(S.colCols[c]);
