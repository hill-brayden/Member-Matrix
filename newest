      route:c.path?c.path.map(p=>p.map(r4)):null,route_kind:c.routeKind||null,route_length:c.path?r4(routeLen(c.path)):null,descriptors:c.ratings?Object.fromEntries(Object.entries(c.ratings).map(([k,v])=>[k,+v.toFixed(1)])):null,route_error:c.error||null,envelope:(c.polygons||[]).map(p=>p.map(q=>q.map(r4))),envelope_holes:(c.holes||[]).map(p=>p.map(q=>q.map(r4))),shortest_route:c.shortPath?c.shortPath.map(p=>p.map(r4)):null,kept:!!S.kept[i],
      envelope_area:c.envInfo?r4(c.envInfo.area):null,typology:Object.fromEntries(Object.entries(tagsOf(i)).map(([k,v])=>[CAT[k].name,CAT[k].items[v-1]]))}))};
  save_(new Blob([JSON.stringify(data,null,1)],{type:'application/json'}),`perceptual-study-${S.seed}.json`);}
let dlP=null;function downloads(){if(!dlP){try{dlP=(window.claude&&window.claude.use)?window.claude.use('downloads'):Promise.resolve(null);}catch(e){dlP=Promise.resolve(null);}}return dlP;}
async function save_(src,filename){if(src&&src.isSVG)filename=filename.replace(/\.png$/,'.svg');const blob=src instanceof Blob?src:await new Promise(r=>src.toBlob(r,'image/png'));let dl=null;try{dl=await downloads();}catch(e){}
  if(dl){try{await dl.save({filename,data:blob});toast(`Saved ${filename}`);return;}catch(e){if(e&&e.code==='declined'){toast('Save cancelled');return;}if(e&&e.code==='rate_limited'){toast('A save prompt is already open');return;}}}
  const url=URL.createObjectURL(blob);const m=document.createElement('div');m.className='modal';
  m.innerHTML=`<div class="modal-card" role="dialog" aria-label="Export preview"><strong>${filename}</strong>${(()=>{const isImg=!(src instanceof Blob)||/^image\//.test(blob.type);return `<p class="hint">${isImg?'Right-click the image (or long-press on a phone) and choose Save image.':'Saving is not available here.'}</p>${isImg?`<img alt="Exported image" src="${url}">`:''}`;})()}<button type="button">Close</button></div>`;
  m.addEventListener('click',e=>{if(e.target===m||e.target.tagName==='BUTTON')m.remove();});document.body.appendChild(m);}
let tT;function toast(msg){let t=document.querySelector('.toast');if(!t){t=document.createElement('div');t.className='toast';t.setAttribute('role','status');document.body.appendChild(t);}t.textContent=msg;t.hidden=false;clearTimeout(tT);tT=setTimeout(()=>t.hidden=true,2600);}

