const FEAT_SHORT={area:'Area',small:'Small area',open:'Interior depth',void:'Deep-interior share',tall:'Tall proportion',wide:'Wide proportion',low:'Sits low',elong:'Elongation',compact:'Compactness',rect:'Rectangular fill',
  stepped:'Stepped outline',terraces:'Horizontal ledges',undulate:'Folded outline',concave:'Inlets',holes:'Pockets',hHoles:'Horizontal slots',holeFrac:'Enclosed-room share',edge:'Along the section edge',compress:'Pinch points',
  widthVar:'Width variation',even:'Even width',levels:'Floor levels',floorLen:'Floor length',climb:'Floors climb one way',dblHeight:'Double-height floor',clearMax:'Tallest clear void',clearVar:'Clear-height jumps',
  alternate:'Low/high ceiling alternation',groundShare:'Floor on the ground',topo:'Rising and falling ground',plate:'Floating plates',single:'One dominant floor',mezz:'Mezzanine floor',overlook:'Floors overlooking a void',room:'Enclosed room',narrow:'Narrow width',pit:'Tall low floor'};
function featFmt(k,v){const P=x=>Math.round(x*100)+'%';switch(k){case'area':return fA(v,0);case'small':return fA(-v,0);case'open':return fL(v,1);case'floorLen':return P(v)+' of width';case'clearMax':return P(v)+' of height';
  case'dblHeight':case'groundShare':case'holeFrac':case'void':case'rect':case'edge':case'single':case'concave':case'mezz':case'overlook':case'room':return P(v);case'pit':return P(v)+' of height';case'narrow':return fL(-v,1)+' wide';case'levels':case'plate':case'holes':case'hHoles':case'terraces':case'alternate':return String(Math.round(v));default:return v.toFixed(2);}}
const TYPO_DEF={"G1": {"def": "An amphitheater is a space whose seating rises in tiers around or in front of a central area, so everyone can see the same point.", "sec": "tiers stepping up toward a lower, taller open area"}, "G2": {"def": "A gathering space organised around a void: a deliberately empty, usually tall space that brings in light and opens up views.", "sec": "a big open shape around a tall, empty middle"}, "G3": {"def": "Essentially a mezzanine: an intermediate floor partway up a tall room, open to the space below.", "sec": "a thin plate partway up a tall space, with space under it and open at its side"}, "G4": {"def": "A room within a room: an enclosed room built inside a larger space as a freestanding object, separate from the outer walls.", "sec": "a room-shaped pocket sitting free inside the shape"}, "G5": {"def": "A gallery: a long, narrow, usually covered passage or room running along the side of a larger space.", "sec": "a long, narrow strip along one edge of the section"}, "O1": {"def": "From the open plan: a layout that uses large open spaces and as few small enclosed rooms as possible.", "sec": "one big open shape with few pockets"}, "O2": {"def": "Terraced: arranged on a series of level platforms stepping up or down, like hillside terraces.", "sec": "several level ledges stepping up or down"}, "O3": {"def": "A deep-plan floor plate: so deep that its centre is far from the windows.", "sec": "one wide, flat floor with a deep interior and an even height"}, "O4": {"def": "Work floors placed at the edge of an atrium or void, so they look into the tall space.", "sec": "floor pieces beside a much taller empty column"}, "O5": {"def": "From landform or folded architecture: floors and roofs bend and rise like landscape, so ground and building merge.", "sec": "a floor line that rises and falls"}, "L1": {"def": "An atrium: a large open space rising several storeys, usually with a glazed roof.", "sec": "a tall vertical shaft of space"}, "L2": {"def": "From compression and release: low, narrow spaces lead into tall, open ones so the open space feels larger.", "sec": "low pinches alternating with tall openings along its length"}, "L3": {"def": "A hall: a large, open, usually single-level room for gathering or circulation; continuous means it runs unbroken.", "sec": "a long, unbroken, even-width band"}, "L4": {"def": "From landform or topographic architecture: the floor works as an artificial landscape.", "sec": "space sitting on a ground that rises and falls"}, "L5": {"def": "A corridor-like gallery used as the entrance or circulation space.", "sec": "a thin, long, corridor-like strip"}};
function typoExplain(t,feat){if(!t||!feat||!FEAT_NORM)return'';const code=t.ranked[0].code,W=TYPO_W[code],tot=Object.values(W).reduce((a,b)=>a+Math.abs(b),0);
  const rows=Object.entries(W).map(([k,w])=>{const[m,sd]=FEAT_NORM[k]||[0,1],z=Math.max(-2.5,Math.min(2.5,(feat[k]-m)/(sd||1)));return{k,w,z,pts:w*z,v:feat[k],m};}).sort((a,b)=>b.pts-a.pts);
  const cmp=r=>Math.abs(r.z)<.25?'about the reference':r.z>0?(r.z>1.5?'far above':'above')+' reference':(r.z<-1.5?'far below':'below')+' reference';
  return`<div class="rexp"><p><b>Why ${code} ${typoName(code)}?</b> ${TYPO_DEF[code]?`<i>${TYPO_DEF[code].def}</i> Read in the 2D section (up is up), that means ${TYPO_DEF[code].sec}.`:'The envelope is read as a 2D section (up is up).'} Each trait is compared with a fixed reference, the average envelope of the ${FEAT_REF_N.toLocaleString()}-cell matrix study, so the result does not depend on the other cells in this matrix. Each of the 15 typologies adds up its own weighted traits; ${code} scored highest.</p>
    <table class="why"><thead><tr><th>Trait</th><th>This</th><th>Ref</th><th>Wt</th><th>Pts</th></tr></thead><tbody>
    ${rows.map(r=>`<tr><td>${FEAT_SHORT[r.k]||r.k}<span class="hint"> · ${cmp(r)}</span></td><td>${featFmt(r.k,r.v)}</td><td>${featFmt(r.k,r.m)}</td><td>${r.w>0?'+':''}${r.w}</td><td class="${r.pts>=0?'pos':'neg'}">${r.pts>=0?'+':''}${r.pts.toFixed(1)}</td></tr>`).join('')}
    </tbody></table>
    <p class="hint">Score = points ÷ total weight (${tot.toFixed(1)}) = <b style="color:var(--ink)">${t.ranked[0].score.toFixed(2)}</b>. Points = weight × how many standard deviations this envelope sits from the reference average (capped at ±2.5), so a trait that is below the reference counts against a typology that wants it. The same envelope always gets the same typology.</p>
    <p class="hint">Runners-up: ${t.ranked.slice(1,4).map(r=>{const best=r.terms[0];return`<b style="color:var(--ink)">${r.code} ${typoName(r.code)}</b> ${r.score.toFixed(2)}${best&&best[1]>0?` (mostly ${FEAT_SHORT[best[0]].toLowerCase()})`:''}`;}).join(' · ')}.</p></div>`;}
function whyWords(rk){const W=TYPO_W[rk.code]||{};return rk.terms.filter(x=>x[1]>0).slice(0,2).map(([k])=>(W[k]??1)>0?FEAT_LABEL[k]:`below-average ${(FEAT_SHORT[k]||k).toLowerCase()}`);}
function typoBlock(i){const c=cells[i],t=c&&c.typo,code=codeOf(i);
  if(!t)return`<p class="hint">${c&&c.error?'No route, so there is no envelope to sort.':'Sorting when the analysis finishes…'}</p>`;
  const top=t.ranked[0],why=whyWords(top);
  return`<button type="button" class="typo-card" data-typo="${i}" aria-expanded="${openTypo===String(i)}" style="--c:${CAT[code[0]].css}"><span class="n">${code}${S.override[i]?' · set by hand':' · sorted automatically'}<span class="why-l">${openTypo===String(i)?'▾ hide why':'▸ why?'}</span></span><strong>${typoName(code)}</strong><span class="hint">${CAT[code[0]].name}</span></button>
